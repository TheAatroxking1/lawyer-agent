LAWYER_ENVIRONMENT=development
# Local development may provide one data and blind-index key; dev.ps1 renders
# each value into the version-1 JSON ring consumed by compose.yaml. Staging and
# production must follow compose.production.env.example and mount managed rings.
LAWYER_DATABASE_URL=mysql+asyncmy://lawyer:lawyer-local-password@mysql:3306/lawyer_agent
LAWYER_SECRET_KEY=replace-with-at-least-32-random-characters
LAWYER_DATA_ENCRYPTION_KEY_B64=AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE=
LAWYER_BLIND_INDEX_KEY_B64=AgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgI=
LAWYER_REFRESH_TOKEN_KEY_B64=AwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwM=
LAWYER_CSRF_KEY_B64=BAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQ=
LAWYER_JWT_ED25519_KEY_RING={"development":"BQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQU="}
LAWYER_DATA_ENCRYPTION_ACTIVE_KEY_VERSION=1
LAWYER_BLIND_INDEX_ACTIVE_KEY_VERSION=1
LAWYER_JWT_ACTIVE_KID=development
LAWYER_TRUSTED_ORIGINS=["http://localhost:5173"]
LAWYER_COOKIE_SECURE=false
LAWYER_JWT_ISSUER=https://identity.lawyer-agent.local
LAWYER_REDIS_SECURITY_TOPOLOGY=standalone
LAWYER_BLIND_INDEX_ROLLOUT_PHASE=legacy-compatible
LAWYER_BLIND_INDEX_LEGACY_KEY_VERSION=1
LAWYER_BLIND_INDEX_LEGACY_WRITERS_DRAINED=false
MYSQL_PASSWORD=lawyer-local-password
RABBITMQ_PASSWORD=lawyer-local-password
MINIO_ROOT_PASSWORD=lawyer-local-password
OPENSEARCH_INITIAL_ADMIN_PASSWORD=Lawyer-local-password-123!
