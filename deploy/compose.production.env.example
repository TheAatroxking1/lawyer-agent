# Production configuration shape only. Provision all files referenced by
# compose.yaml through the deployment secret manager; never store key material here.
LAWYER_ENVIRONMENT=production
LAWYER_DATABASE_URL=mysql+asyncmy://app:<password>@mysql.example.cn:3306/lawyer_agent
LAWYER_REDIS_URL=rediss://redis.example.cn:6379/0
LAWYER_REDIS_SECURITY_TOPOLOGY=sentinel-primary
LAWYER_DATA_ENCRYPTION_ACTIVE_KEY_VERSION=2609
LAWYER_BLIND_INDEX_ACTIVE_KEY_VERSION=2610
LAWYER_BLIND_INDEX_ROLLOUT_PHASE=rotation-ready
LAWYER_BLIND_INDEX_LEGACY_KEY_VERSION=2609
LAWYER_BLIND_INDEX_LEGACY_WRITERS_DRAINED=true
LAWYER_JWT_ACTIVE_KID=release-2026-09
LAWYER_TRUSTED_ORIGINS=["https://app.example.cn"]
LAWYER_COOKIE_SECURE=true
LAWYER_JWT_ISSUER=https://identity.example.cn

# Required untracked secret files and formats:
# deploy/secrets/lawyer_app_secret_key                 plain text
# deploy/secrets/lawyer_data_encryption_key_ring       JSON {"<version>":"<base64-32-byte-key>"}
# deploy/secrets/lawyer_blind_index_key_ring           JSON {"<version>":"<base64-32-byte-key>"}
# deploy/secrets/lawyer_refresh_token_key              base64-encoded 32-byte key
# deploy/secrets/lawyer_csrf_key                       base64-encoded 32-byte key
# deploy/secrets/lawyer_jwt_ed25519_key_ring            JSON {"<kid>":"<base64-32-byte-seed>"}
